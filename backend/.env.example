# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this

# Database Configuration
# For development (SQLite)
DATABASE_URL=sqlite:///traqcheck.db
# For production (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/traqcheck

# AI API Keys (use one of the following)
OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_FOLDER=uploads
DOCUMENTS_FOLDER=documents

# Email Configuration
# Set to 'false' for production email sending, 'true' for development (simulated emails)
SIMULATE_EMAIL=true
# SMTP settings (required only if SIMULATE_EMAIL=false)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=your-email@gmail.com

# Server Configuration
PORT=5000
